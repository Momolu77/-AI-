# ═══════════════════════════════════════════════════════
# 环境变量配置模板（通义千问版本）
# ═══════════════════════════════════════════════════════
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写 DASHSCOPE_API_KEY（必需）
# 3. 其他配置保持默认即可
#
# ═══════════════════════════════════════════════════════

# 数据库配置
# SQLite 数据库文件会自动创建在项目根目录
# 无需安装 PostgreSQL 或其他数据库服务器
# 格式: sqlite+aiosqlite:///./文件名.db
DATABASE_URL=sqlite+aiosqlite:///./metacog.db

# Redis配置（已废弃，保留以兼容旧代码）
# 系统使用 Python 字典作为内存缓存，无需安装 Redis
# 格式: redis://主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0

# 阿里云百炼 API（必需）
# 从 https://bailian.console.aliyun.com/ 获取
# 或使用 DashScope API Key: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型配置（可选，默认值已配置）
# 主对话模型：用于与学生对话，流式输出
CHAT_MODEL=qwen3.8-flash
# 判断模型：用于结构化输出（目标明确度、追问、纠错、编辑深度）
JUDGE_MODEL=qwen3.7-flash
# 上下文限制：最大 token 数（默认 24K，留余量）
MAX_CONTEXT_TOKENS=24000

# CORS配置（允许的前端地址）
CORS_ORIGINS=["http://localhost:5173"]

# 服务器配置（可选）
# APP_HOST=0.0.0.0
# APP_PORT=8000
# APP_ENV=development

# 日志级别（可选）
# LOG_LEVEL=INFO

